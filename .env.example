# Copy to .env (or .env.local, which wins over .env) and fill in.
#
# Every setting and its default is in src/drrepo/defaults.toml. This file only
# overrides: set any key from there in upper case (max_tokens -> MAX_TOKENS).
# Reference: docs/configuration.md
#
# Every variable is optional except an LLM key for the provider you choose;
# without one, DrRepo still runs and produces a fully deterministic report
# (no LLM narratives, no deep investigation).

# --- Secrets (environment only, never in defaults.toml) -------------------------------
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=                # uv sync --extra anthropic
# A token with no scopes is enough; raises the GitHub API limit from 60 to 5000
# requests/hour. GITHUB_TOKEN is also accepted.
GH_TOKEN=

# --- Common overrides (defaults in src/drrepo/defaults.toml) ---------------------------
# MODEL_PROVIDER=groq               # groq | openai | anthropic | ollama
# MODEL_NAME=                       # empty = the provider's default model
# ENABLE_SEMGREP=false              # skip the slowest scanner
# ENABLE_DEEP_INVESTIGATION=false   # no tool-calling investigations
# STORE_BACKEND=sqlite              # keep full reports and API jobs
# On a paid Groq tier, lift the free-tier limits of [providers.groq]:
# LLM_MAX_PARALLEL_INVESTIGATIONS=0
# INVESTIGATION_CONTEXT_TOKENS=32000
# INVESTIGATOR_TIMEOUT_SECONDS=90
