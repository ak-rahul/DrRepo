# Copy to .env and fill in. Every variable is optional except an LLM key for the
# provider you choose; without one, DrRepo still runs and produces a fully
# deterministic report (no LLM narratives, no deep investigation).
# Full reference: docs/configuration.md

# --- LLM provider ---------------------------------------------------------------
MODEL_PROVIDER=groq                # groq | openai | anthropic | ollama
# MODEL_NAME=                       # default per provider (see docs/configuration.md)
# MODEL_NAME_PLANNER=               # per-role overrides, each defaulting to MODEL_NAME
# MODEL_NAME_NARRATIVE=
# MODEL_NAME_INVESTIGATION=
GROQ_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=                # uv sync --extra anthropic
# OLLAMA_BASE_URL=http://localhost:11434   # uv sync --extra ollama
TEMPERATURE=0.3
MAX_TOKENS=2000
LLM_REQUEST_TIMEOUT_SECONDS=60

# --- GitHub -----------------------------------------------------------------------
# Optional, but raises the API limit from 60 to 5000 requests/hour. A token with
# no scopes (public repo read only) is enough. GITHUB_TOKEN is also accepted.
GH_TOKEN=

# --- Clone and collector limits ----------------------------------------------------
CLONE_TIMEOUT_SECONDS=60
CLONE_MAX_SIZE_MB=300
COLLECTOR_TIMEOUT_SECONDS=120

# --- Collector toggles -------------------------------------------------------------
ENABLE_SEMGREP=true
ENABLE_BANDIT=true
ENABLE_DEPENDENCY_AUDIT=true
ENABLE_LICENSE_AUDIT=true
# License policy (comma-separated SPDX ids). Either one replaces the copyleft heuristic.
LICENSE_DENY=
LICENSE_ALLOW=

# --- Agentic investigation ---------------------------------------------------------
ENABLE_DEEP_INVESTIGATION=true
MAX_TOOL_CALLS_PER_INVESTIGATOR=8
INVESTIGATOR_TIMEOUT_SECONDS=90

# --- Resilience and cost -----------------------------------------------------------
ENABLE_LLM_CIRCUIT_BREAKER=true
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_TIMEOUT_SECONDS=300
ENABLE_LLM_BUDGET_TRACKING=true
LLM_TOKEN_BUDGET_PER_RUN=60000
ESTIMATED_TOKENS_PER_DEEP_INVESTIGATION=12000
ENABLE_DEPENDENCY_LOOKUP_CACHE=true
ENABLE_SCORE_HISTORY=true
# SUPPRESSIONS_FILE=.drrepo.toml
# TRUST_REPO_SUPPRESSIONS=false

# --- Logging -----------------------------------------------------------------------
LOG_LEVEL=INFO
