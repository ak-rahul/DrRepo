# LLM Provider Configuration
MODEL_PROVIDER=groq  # Options: groq, openai
MODEL_NAME=llama-3.3-70b-versatile
TEMPERATURE=0.3
MAX_TOKENS=2000

# API Keys
GROQ_API_KEY=your_groq_api_key_here
GH_TOKEN=your_github_token_here

# OpenAI (optional - only if using openai provider)
OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
LOG_LEVEL=INFO

# Retry Configuration (optional - defaults provided)
RETRY_BACKOFF_FACTOR=2.0
RETRY_INITIAL_DELAY=1.0
RETRY_MAX_DELAY=60.0

# Repository cloning limits
CLONE_TIMEOUT_SECONDS=60
CLONE_MAX_SIZE_MB=300
COLLECTOR_TIMEOUT_SECONDS=120

# Collector feature toggles (disable if a tool isn't available on your host)
ENABLE_SEMGREP=true
ENABLE_BANDIT=true
ENABLE_DEPENDENCY_AUDIT=true

# License compatibility checking: cross-checks each dependency's license
# (looked up via deps.dev) against the repository's own license, flagging
# e.g. a strong-copyleft dependency in a permissively-licensed project.
# Set to false to skip the extra deps.dev lookups (fewer, faster requests).
ENABLE_LICENSE_AUDIT=true

# Agentic investigation (v3): the Lead Investigator decides per-repo which
# categories get a tool-calling deep-dive vs. a quick pass. Set to false to
# force every category "shallow" (v2 behavior) -- a fast/cheap fallback mode.
ENABLE_DEEP_INVESTIGATION=true
MAX_TOOL_CALLS_PER_INVESTIGATOR=8
INVESTIGATOR_TIMEOUT_SECONDS=90

# LLM circuit breaker: opens after repeated LLM-call failures within a run
# (e.g. a real provider rate limit) so parallel/subsequent category nodes
# fail fast instead of each independently retrying against an exhausted quota.
ENABLE_LLM_CIRCUIT_BREAKER=true
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_TIMEOUT_SECONDS=300

# LLM token budget: a rough, run-scoped cap so the planner's shallow/deep
# decisions are cost-aware. A category marked "deep" still falls back to
# shallow if the run doesn't have enough estimated budget left to afford it.
ENABLE_LLM_BUDGET_TRACKING=true
LLM_TOKEN_BUDGET_PER_RUN=60000
ESTIMATED_TOKENS_PER_DEEP_INVESTIGATION=12000

# Per-package OSV/deps.dev lookup cache: skips re-querying a package version
# already looked up (within one run, or across runs in the Streamlit app,
# which shares one cache instance for its whole process lifetime).
ENABLE_DEPENDENCY_LOOKUP_CACHE=true

# Score-history tracking: append each run's scores to reports/history.json,
# keyed by repository, so a later run can report a regression/improvement
# delta against the previous analysis of the same repo.
ENABLE_SCORE_HISTORY=true
